NODE_ENV=development
PORT=4000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE_NAME=hotel
MYSQL_USERNAME=hotel
MYSQL_DATABASE_PASSWORD=hotel_dev_password
DB_SYNC_ALTER=false
AUTO_SEED=false

REDIS_URI=redis://127.0.0.1:6380
REDIS_CACHE_TTL=300

JWT_SECRET=replace-with-a-long-random-secret

# Account email delivery. Use an HTTPS frontend origin in production.
ACCOUNT_EMAIL_ORIGIN=http://localhost:3000
ACCOUNT_EMAIL_SMTP_URL=
ACCOUNT_EMAIL_FROM=

# The bundled SMS OTP is a fixed test code; enable only in local development.
ENABLE_DEMO_SMS_OTP=false

# Set only when the API is reachable solely through this many trusted proxies.
TRUST_PROXY_HOPS=0
